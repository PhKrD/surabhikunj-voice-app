# ---- Shipped inside the app (public by design; protected by RLS) --------
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here
VITE_DEFAULT_VOICE_ID=a1b2c3d4-e5f6-7890-abcd-ef1234567890
# Base URL of the public OTA bucket (…/storage/v1/object/public/app-bundles).
# Empty = no over-the-air updates.
VITE_OTA_BASE_URL=
# Public web address of the app. Password-reset emails link here, because a
# link in an email cannot open the APK's internal address.
VITE_PUBLIC_APP_URL=https://your-app.vercel.app
# Web Push public key (npm run gen:vapid).
VITE_VAPID_PUBLIC_KEY=

# ---- Local scripts only. NEVER prefix with VITE_ (that would ship it) ---
# Used by scripts/deploy-ota.mjs to upload bundles.
SUPABASE_SERVICE_ROLE_KEY=
