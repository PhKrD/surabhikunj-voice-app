{
  "name": "surabhikunj-voice-app",
  "private": true,
  "version": "0.0.31",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "node --test \"src/**/*.test.js\"",
    "cap:sync": "vite build && cap sync",
    "ios": "vite build && cap sync ios && cap open ios",
    "android": "vite build && cap sync android && cap open android",
    "apk": "bash scripts/build-apk.sh",
    "deploy:ota": "node scripts/deploy-ota.mjs",
    "gen:vapid": "node scripts/gen-vapid.mjs",
    "import:devotees": "node scripts/import-devotees.mjs",
    "test:smoke": "node --env-file=.env scripts/dev/smoke-test.mjs",
    "assets:android": "bash scripts/generate-app-assets.sh"
  },
  "dependencies": {
    "@capacitor/app": "8.1.1",
    "@capacitor/core": "^8.4.0",
    "@capacitor/filesystem": "^8.1.3",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/keyboard": "8.0.5",
    "@capacitor/network": "8.0.1",
    "@capacitor/push-notifications": "^8.1.1",
    "@capacitor/share": "^8.0.1",
    "@capacitor/splash-screen": "8.0.2",
    "@capacitor/status-bar": "8.0.3",
    "@capgo/capacitor-updater": "^8.49.1",
    "@fontsource-variable/inter": "5.3.0",
    "@supabase/supabase-js": "^2.112.3",
    "@tailwindcss/vite": "^4.3.0",
    "clsx": "^2.1.1",
    "date-fns": "^4.3.0",
    "framer-motion": "^12.40.0",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "lucide-react": "^1.16.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-router-dom": "^7.18.4",
    "recharts": "^3.8.1",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.0",
    "write-excel-file": "^4.1.1",
    "zustand": "^5.0.13"
  },
  "devDependencies": {
    "@capacitor/android": "^8.4.0",
    "@capacitor/cli": "^8.4.0",
    "@capacitor/ios": "^8.4.0",
    "@eslint/js": "^10.0.1",
    "@types/node": "^25.9.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "typescript": "^6.0.3",
    "vite": "^8.0.12"
  },
  "overrides": {
    "dompurify": "3.4.16"
  },
  "ota": {
    "minNativeVersionCode": 2,
    "//": "Oldest APK versionCode the current JS supports. Every native call is guarded (src/lib/native.js), so 2 = also the original APK."
  }
}
